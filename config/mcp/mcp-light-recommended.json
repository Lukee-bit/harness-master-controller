{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_CONTEXT7_API_KEY"
      }
    },
    "awwwards": {
      "command": "npx",
      "args": [
        "-y",
        "awwwards-mcp"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GH_TOKEN"
      }
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {
        "HEADROOM_SAVINGS_PROFILE": "agent-90",
        "HEADROOM_FORCE_KOMPRESS": "1",
        "HEADROOM_MODE": "token",
        "HEADROOM_TARGET_RATIO": "0.10",
        "HEADROOM_MIN_TOKENS": "120",
        "HEADROOM_COMPRESS_SYSTEM_MESSAGES": "1",
        "HEADROOM_COMPRESS_USER_MESSAGES": "1",
        "HEADROOM_CODE_AWARE_ENABLED": "1",
        "HEADROOM_PROTECT_ANALYSIS_CONTEXT": "1",
        "HEADROOM_PROTECT_RECENT": "0",
        "HEADROOM_ACCURACY_GUARD": "strict",
        "HEADROOM_PROXY_URL": "http://127.0.0.1:8787"
      }
    },
    "jcodemunch": {
      "command": "jcodemunch-mcp",
      "args": [
        "serve"
      ]
    },
    "sqz": {
      "command": "sqz-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {}
    },
    "squeez": {
      "command": "squeez",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "context-mode": {
      "command": "context-mode",
      "args": []
    },
    "claude-context": {
      "command": "npx",
      "args": [
        "-y",
        "@zilliz/claude-context-mcp@latest"
      ],
      "env": {
        "EMBEDDING_PROVIDER": "Ollama",
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_MODEL": "nomic-embed-text",
        "MILVUS_ADDRESS": "127.0.0.1:19530",
        "MILVUS_TOKEN": "",
        "HYBRID_MODE": "false"
      }
    },
    "context-engine": {
      "command": "cce",
      "args": [
        "serve",
        "--project-dir",
        "."
      ]
    }
  },
  "_advisor": "Install separately: /add-plugin advisor",
  "_note": "Merge mcpServers into your Cursor MCP settings. Replace placeholder secrets. Headroom is mandatory.",
  "_headroom": "ALWAYS REQUIRED. Force-enabled Layer B. Install CLI via scripts/setup-headroom.sh. Proxy + Override OpenAI Base URL also required.",
  "_token_optimizers": "ALWAYS REQUIRED (Layer B). jcodemunch, sqz, squeez, context-mode, claude-context, context-engine, rtk compress context before the model reads it. Install via scripts/setup-token-optimizers.sh; forced by ~/.cursor/rules/{rtk,mcptoon,context-mode,sqz-squeez,jcodemunch,claude-context,cce}.mdc. claude-context needs local Milvus (127.0.0.1:19530) + Ollama (nomic-embed-text); context-engine needs `cce init` per project."
}
